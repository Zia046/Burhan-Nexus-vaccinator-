<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14,10">
            <WrapPanel>
                <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="From" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding From}" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="To" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding To}" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,10,0"><TextBlock Text="Vaccine" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Vaccines}" SelectedItem="{Binding Vaccine}" DisplayMemberPath="Name" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Width="220" Margin="0,0,10,0"><TextBlock Text="Patient / batch" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Search}" Margin="0,2,0,0"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox></StackPanel>
                <Button Content="Show" Command="{Binding SearchCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                <Button Content="Print" Command="{Binding PrintCommand}" Style="{StaticResource NavyButton}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                <Button Content="Excel" Command="{Binding ExcelCommand}" Style="{StaticResource Secondary}" VerticalAlignment="Bottom"/>
            </WrapPanel>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Record" Binding="{Binding RecordNo}" Width="95"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="95"/>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="80"/>
                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientNo}" Width="100"/>
                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="120"/>
                <DataGridTextColumn Header="Dose" Binding="{Binding Dose}" Width="*"/>
                <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="60"/>
                <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="100"/>
                <DataGridTextColumn Header="By" Binding="{Binding AdministeredBy}" Width="*"/>
                <DataGridCheckBoxColumn Header="Old card" Binding="{Binding Historical}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding Count}" Foreground="#64748B" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
