<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BurhanNexus.Vaccinator.Desktop.ViewModels"
             xmlns:v="clr-namespace:BurhanNexus.Vaccinator.Desktop.Views">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Alert}" Visibility="{Binding Alerts, Converter={x:Static v:NullToCollapsed.Instance}}">
            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Alerts}" TextWrapping="Wrap" Foreground="#991B1B" FontWeight="SemiBold"/>
            </ScrollViewer>
        </Border>
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Available Stock (Batches)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBox Text="{Binding Search}" Width="200" Margin="0,0,6,0"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox>
                        <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource Small}" Background="#6B91B5"/>
                        <Button Content="Stock Out" Command="{Binding StockOutCommand}" Style="{StaticResource Small}"/>
                        <Button Content="Wastage" Command="{Binding WastageCommand}" Style="{StaticResource Small}" Background="#C2410C"/>
                        <Button Content="Dispose Expired" Command="{Binding ExpiredCommand}" Style="{StaticResource Small}" Background="#B91C1C"/>
                        <Button Content="Quarantine / Release" Command="{Binding QuarantineCommand}" Style="{StaticResource Small}" Background="#7C2D12"/>
                        <TextBlock Text="VVM:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#475569"/>
                        <Button Content="1" Command="{Binding VvmCommand}" CommandParameter="Stage1" Style="{StaticResource Small}" Background="#15803D" ToolTip="VVM stage 1"/>
                        <Button Content="2" Command="{Binding VvmCommand}" CommandParameter="Stage2" Style="{StaticResource Small}" Background="#65A30D" ToolTip="VVM stage 2"/>
                        <Button Content="3" Command="{Binding VvmCommand}" CommandParameter="Stage3" Style="{StaticResource Small}" Background="#B91C1C" ToolTip="VVM stage 3 – discard"/>
                        <Button Content="4" Command="{Binding VvmCommand}" CommandParameter="Stage4" Style="{StaticResource Small}" Background="#7F1D1D" ToolTip="VVM stage 4 – discard"/>
                        <Button Content="N/A" Command="{Binding VvmCommand}" CommandParameter="NotApplicable" Style="{StaticResource Small}" Background="#64748B"/>
                        <Button Content="Stock Report" Command="{Binding ReportCommand}" Style="{StaticResource Small}" Background="#334155"/>
                        <Button Content="Excel" Command="{Binding ExcelCommand}" Style="{StaticResource Small}" Background="#0F766E"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Batches}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="120"/>
                            <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="*"/>
                            <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="*"/>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="110"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="70"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="75"/>
                            <DataGridTextColumn Header="Vial size" Binding="{Binding VialSize}" Width="75"/>
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryText}" Width="95"/>
                            <DataGridTextColumn Header="VVM" Binding="{Binding Vvm}" Width="85"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="115" ElementStyle="{StaticResource StatusText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding Totals}" Foreground="#64748B" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Stock In (Receive)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}" MaxWidth="1000" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Receive vaccine stock" Style="{StaticResource Section}"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Vaccine *" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Vaccines}" SelectedItem="{Binding NewVaccine}" DisplayMemberPath="Name"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Brand" Style="{StaticResource Label}"/><TextBox Text="{Binding Brand}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Manufacturer" Style="{StaticResource Label}"/><TextBox Text="{Binding Manufacturer}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Batch Number *" Style="{StaticResource Label}"/><TextBox Text="{Binding BatchNumber}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Quantity Received (doses) *" Style="{StaticResource Label}"/><TextBox Text="{Binding Quantity}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Vial Size (e.g. 10 doses)" Style="{StaticResource Label}"/><TextBox Text="{Binding VialSize}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Expiry Date *" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Expiry}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Manufacturing Date" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Manufactured}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Supplier" Style="{StaticResource Label}"/><TextBox Text="{Binding Supplier}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Purchase / Receipt Date" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Purchased}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Storage Temperature" Style="{StaticResource Label}"/><TextBox Text="{Binding Storage}" ToolTip="Empty = from the vaccine database"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="VVM Status" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:Lists.VvmStates}" SelectedItem="{Binding Vvm}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Stock Location" Style="{StaticResource Label}"/><TextBox Text="{Binding Location}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Low-stock alert level (doses)" Style="{StaticResource Label}"/><TextBox Text="{Binding LowLevel}"/></StackPanel>
                            </WrapPanel>
                            <Button Content="Save Stock" Command="{Binding StockInCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Transactions">
                <DataGrid Margin="0,8,0,0" ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date / time" Binding="{Binding AtText}" Width="150"/>
                        <DataGridTextColumn Header="Transaction" Binding="{Binding TransactionNo}" Width="180"/>
                        <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="120"/>
                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="110"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Reason / reference" Binding="{Binding Reason}" Width="*"/>
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Cold Chain">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,10,0"><TextBlock Text="Refrigerator / cold box" Style="{StaticResource Label}"/><TextBox Text="{Binding TempLocation}" Margin="0,2,0,0"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,10,0"><TextBlock Text="Temperature °C" Style="{StaticResource Label}"/><TextBox Text="{Binding TempValue}" Margin="0,2,0,0"/></StackPanel>
                            <StackPanel Width="260" Margin="0,0,10,0"><TextBlock Text="Remarks" Style="{StaticResource Label}"/><TextBox Text="{Binding TempRemarks}" Margin="0,2,0,0"/></StackPanel>
                            <Button Content="Record Temperature" Command="{Binding TempCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Temperatures}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers><DataTrigger Binding="{Binding Excursion}" Value="True"><Setter Property="Foreground" Value="#B91C1C"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Recorded at" Binding="{Binding AtText}" Width="160"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                            <DataGridTextColumn Header="°C" Binding="{Binding TemperatureC}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="240"/>
                            <DataGridTextColumn Header="By" Binding="{Binding RecordedBy}" Width="140"/>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
