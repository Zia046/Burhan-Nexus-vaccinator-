<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.VaccinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="Edit Vaccine Database" Command="{Binding EditCommand}" Margin="0,8,0,0"/>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" FontSize="14" BorderBrush="#D8E5EC" Padding="4"/>
        </DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,4"/><Setter Property="TextWrapping" Value="Wrap"/></Style></Grid.Resources>
                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Selected.FullName}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                        <TextBlock Grid.Row="1" Text="Short name / code" FontWeight="SemiBold"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding Selected.Name}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Selected.Code}"/></StackPanel>
                        <TextBlock Grid.Row="2" Text="Disease prevented" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.DiseasePrevented}"/>
                        <TextBlock Grid.Row="3" Text="Recommended age" FontWeight="SemiBold"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.RecommendedAge}"/>
                        <TextBlock Grid.Row="4" Text="Minimum age" FontWeight="SemiBold"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.MinimumAge}"/>
                        <TextBlock Grid.Row="5" Text="Dose volume" FontWeight="SemiBold"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.DoseVolume}"/>
                        <TextBlock Grid.Row="6" Text="Route" FontWeight="SemiBold"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Selected.Route}"/>
                        <TextBlock Grid.Row="7" Text="Injection site" FontWeight="SemiBold"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Selected.InjectionSite}"/>
                        <TextBlock Grid.Row="8" Text="Booster requirements" FontWeight="SemiBold"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Selected.BoosterRequirements}"/>
                        <TextBlock Grid.Row="9" Text="Storage temperature" FontWeight="SemiBold"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Selected.StorageTemperature}"/>
                        <TextBlock Grid.Row="10" Text="Special instructions" FontWeight="SemiBold"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Selected.SpecialInstructions}"/>
                        <TextBlock Grid.Row="11" Text="Reference / source" FontWeight="SemiBold"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Selected.Reference}" Foreground="#64748B"/>
                        <TextBlock Grid.Row="12" Text="Last updated" FontWeight="SemiBold"/><TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Selected.LastUpdated}"/>
                    </Grid>
                </Border>
                <TextBlock Text="Protocols (separate schedules per group)" Style="{StaticResource Section}"/>
                <ItemsControl ItemsSource="{Binding SelectedProtocols}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Navy}"/>
                                    <TextBlock Text="{Binding Group}" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Doses}" TextWrapping="Wrap" Margin="0,6,0,4" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Approved}" FontSize="11.5" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding CatchUp}" TextWrapping="Wrap" FontSize="11.5"/>
                                    <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="11.5" Foreground="#991B1B"/>
                                    <TextBlock Text="{Binding Reference}" TextWrapping="Wrap" FontSize="11" Foreground="#78716C"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
