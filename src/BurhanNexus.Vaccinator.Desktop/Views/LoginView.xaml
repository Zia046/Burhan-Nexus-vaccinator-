<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Width="400" Padding="32" Style="{StaticResource GlassCard}" Effect="{StaticResource CardShadow}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <Image Source="pack://application:,,,/BurhanNexus.Vaccinator;component/Assets/icon-256.png" Width="90" Height="90" HorizontalAlignment="Center"/>
                <TextBlock Text="Burhan Nexus Vaccinator" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Navy}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding CenterName}" Foreground="{StaticResource Primary}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="Sign in to continue" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,22"/>
                <TextBlock Text="Username" Style="{StaticResource Label}"/>
                <TextBox x:Name="User" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Password" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="Pwd" PasswordChanged="OnPassword"/>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="Sign in" Command="{Binding LoginCommand}" IsDefault="True"/>
            </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Image Source="pack://application:,,,/BurhanNexus.Vaccinator;component/Assets/burhan-nexus-logo.png" Height="40" HorizontalAlignment="Center"/>
            <TextBlock Text="Developed by Burhan Nexus  ·  03475093446  ·  ziaullah.046@gmail.com" Foreground="#475569" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
