<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.RabiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BurhanNexus.Vaccinator.Desktop.ViewModels"
             xmlns:v="clr-namespace:BurhanNexus.Vaccinator.Desktop.Views">
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="Patient Lists &amp; Tracking">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="12,10">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="All" Command="{Binding ListCommand}" CommandParameter="All" Style="{StaticResource Small}" Background="#475569"/>
                            <Button Content="1st Dose Pending" Command="{Binding ListCommand}" CommandParameter="FirstDosePending" Style="{StaticResource Small}"/>
                            <Button Content="2nd Dose Pending" Command="{Binding ListCommand}" CommandParameter="SecondDosePending" Style="{StaticResource Small}"/>
                            <Button Content="3rd Dose Pending" Command="{Binding ListCommand}" CommandParameter="ThirdDosePending" Style="{StaticResource Small}"/>
                            <Button Content="4th Dose Pending" Command="{Binding ListCommand}" CommandParameter="FourthDosePending" Style="{StaticResource Small}"/>
                            <Button Content="Today's Due" Command="{Binding ListCommand}" CommandParameter="DueToday" Style="{StaticResource Small}" Background="#B45309"/>
                            <Button Content="Upcoming" Command="{Binding ListCommand}" CommandParameter="Upcoming" Style="{StaticResource Small}" Background="#0369A1"/>
                            <Button Content="Overdue" Command="{Binding ListCommand}" CommandParameter="Overdue" Style="{StaticResource Small}" Background="#B91C1C"/>
                            <Button Content="Completed" Command="{Binding ListCommand}" CommandParameter="Completed" Style="{StaticResource Small}" Background="#15803D"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Record Next Dose" Command="{Binding GiveCommand}" Style="{StaticResource Small}" Background="#15803D"/>
                            <Button Content="Open Patient" Command="{Binding OpenCommand}" Style="{StaticResource Small}" Background="#123B50"/>
                            <Button Content="Print Anti-Rabies Card" Command="{Binding PrintCommand}" Style="{StaticResource Small}" Background="#334155"/>
                            <TextBox Text="{Binding Search}" Width="200" Margin="12,0,6,0">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource Small}" Background="#6B91B5"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Cases}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers><DataTrigger Binding="{Binding Alert}" Value="True"><Setter Property="Foreground" Value="#991B1B"/></DataTrigger></Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Case" Binding="{Binding CaseNo}" Width="85"/>
                        <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientNo}" Width="100"/>
                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                        <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="115"/>
                        <DataGridTextColumn Header="Bite date" Binding="{Binding BiteText}" Width="95"/>
                        <DataGridTextColumn Header="Animal" Binding="{Binding Animal}" Width="80"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="95"/>
                        <DataGridTextColumn Header="Doses" Binding="{Binding Progress}" Width="65"/>
                        <DataGridTextColumn Header="Next due" Binding="{Binding NextText}" Width="95"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Text="{Binding Count}" Foreground="#64748B" Margin="0,6,0,0"/>
            </Grid>
        </TabItem>

        <TabItem Header="New Anti-Rabies Case">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Alert}">
                        <TextBlock TextWrapping="Wrap" Foreground="#991B1B">
                            <Run FontWeight="SemiBold" Text="Wound washing: "/><Run Text="wash the wound immediately with soap and running water for about 15 minutes. "/>
                            <Run FontWeight="SemiBold" Text="Category III exposures and immunocompromised patients need professional assessment (RIG). "/>
                            <Run Text="This software records and schedules; it does not decide the exposure category or the treatment."/>
                        </TextBlock>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Patient" Style="{StaticResource Section}"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearPatientCommand}" Style="{StaticResource Small}" Background="#6B91B5"/>
                                <Button DockPanel.Dock="Right" Content="Find Existing Patient" Command="{Binding FindCommand}" Style="{StaticResource Small}"/>
                                <TextBox Text="{Binding FindText}" Margin="0,0,8,0" ToolTip="Name, patient ID, CNIC or mobile"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ExistingText}" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="0,0,0,6"/>
                            <WrapPanel Visibility="{Binding IsNewPatient, Converter={StaticResource BoolToVis}}">
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Patient Name *" Style="{StaticResource Label}"/><TextBox Text="{Binding Name}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Father / Husband Name" Style="{StaticResource Label}"/><TextBox Text="{Binding Guardian}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Age (years) *" Style="{StaticResource Label}"/><TextBox Text="{Binding Age}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Gender" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:Lists.Genders}" SelectedItem="{Binding Gender}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Mobile Number" Style="{StaticResource Label}"/><TextBox Text="{Binding Mobile}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="CNIC Number" Style="{StaticResource Label}"/><TextBox Text="{Binding Cnic}"/></StackPanel>
                                <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Address" Style="{StaticResource Label}"/><TextBox Text="{Binding Address}"/></StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Exposure" Style="{StaticResource Section}"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Date of Animal Bite" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding BiteDate}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Animal Type" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:Lists.Animals}" SelectedItem="{Binding Animal}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Other animal (if Other)" Style="{StaticResource Label}"/><TextBox Text="{Binding AnimalOther}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Bite Category (as assessed by the professional)" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:Lists.BiteCategories}" SelectedItem="{Binding Category}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Bite Location" Style="{StaticResource Label}"/><TextBox Text="{Binding BiteLocation}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Advised By" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" IsEditable="True" ItemsSource="{Binding DoctorNames}" Text="{Binding AdvisedBy, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </WrapPanel>
                            <CheckBox Content="Wound washed with soap and water" IsChecked="{Binding WoundWashed}"/>
                            <CheckBox Content="Immunocompromised patient (flag for clinical review)" IsChecked="{Binding Immunocompromised}"/>
                            <Border Style="{StaticResource Alert}" Visibility="{Binding IsCategory3, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CATEGORY III EXPOSURE – professional assessment required. Record Rabies Immunoglobulin (RIG) below if given." Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Vaccination protocol" Style="{StaticResource Section}"/>
                            <CheckBox Content="Previously vaccinated against rabies (documented PrEP or PEP)" IsChecked="{Binding PreviouslyVaccinated}"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Previous rabies vaccination history" Style="{StaticResource Label}"/><TextBox Text="{Binding PreviousDetails}"/></StackPanel>
                                <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Protocol (selected by the healthcare professional) *" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" DisplayMemberPath="Name"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Date of First Vaccine" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding FirstVaccineDate}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Vaccine Brand" Style="{StaticResource Label}"/><TextBox Text="{Binding VaccineBrand}"/></StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding ProtocolInfo}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11.5" Margin="0,0,0,10"/>
                            <TextBlock Text="Rabies Immunoglobulin (when indicated)" Style="{StaticResource Label}" Margin="0,4,0,4"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="RIG type" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:Lists.RigTypes}" SelectedItem="{Binding Rig}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="RIG dose (as prescribed)" Style="{StaticResource Label}"/><TextBox Text="{Binding RigDose}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="RIG batch" Style="{StaticResource Label}"/><TextBox Text="{Binding RigBatch}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="RIG date" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding RigDate}"/></StackPanel>
                                <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Remarks" Style="{StaticResource Label}"/><TextBox Text="{Binding Remarks}"/></StackPanel>
                            </WrapPanel>
                            <CheckBox Content="Record the first dose now (opens the administration form)" IsChecked="{Binding GiveFirstDoseNow}"/>
                            <Button Content="Save Case &amp; Generate Schedule" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Background="#B91C1C"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
