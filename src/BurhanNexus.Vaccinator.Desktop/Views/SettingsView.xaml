<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BurhanNexus.Vaccinator.Desktop.ViewModels">
    <TabControl Background="Transparent" BorderThickness="0" SelectedIndex="{Binding TabIndex, Mode=OneTime}">
        <!-- 0 -->
        <TabItem Header="Center &amp; Printing" Visibility="{Binding CanAdmin, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Hospital / vaccination center" Style="{StaticResource Section}"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Hospital / Center Name (shown on screen and printouts)" Style="{StaticResource Label}"/><TextBox Text="{Binding CenterName}"/></StackPanel>
                                <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Address" Style="{StaticResource Label}"/><TextBox Text="{Binding Address}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Phone Number" Style="{StaticResource Label}"/><TextBox Text="{Binding Phone}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Email" Style="{StaticResource Label}"/><TextBox Text="{Binding Email}"/></StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Hospital Logo" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                <Border Width="120" Height="70" BorderBrush="#D8E5EC" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Background="White">
                                    <Image Source="{Binding Logo}" Stretch="Uniform" Margin="4"/>
                                </Border>
                                <Button Content="Choose Logo" Command="{Binding LogoCommand}" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                                <Button Content="Remove" Command="{Binding RemoveLogoCommand}" Style="{StaticResource Small}" Background="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Formats, theme &amp; printer" Style="{StaticResource Section}"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Date format" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding DateFormats}" SelectedItem="{Binding DateFormat}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Software theme" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="Clean White – Medical Teal (default)"/></ComboBox></StackPanel>
                            </WrapPanel>
                            <CheckBox Content="24-hour time format" IsChecked="{Binding Use24Hour}"/>
                            <CheckBox Content="Send documents directly to the default printer (otherwise a print preview opens first)" IsChecked="{Binding PrintDirectly}"/>
                            <TextBlock Text="Printouts are A4 (insulin receipts A5) with your center name, Burhan Nexus branding and a signature area." Style="{StaticResource SubTitle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Developer contact (About &amp; printouts)" Style="{StaticResource Section}"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Developer / brand" Style="{StaticResource Label}"/><TextBox Text="{Binding DeveloperName}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Contact email" Style="{StaticResource Label}"/><TextBox Text="{Binding DeveloperEmail}"/></StackPanel>
                                <StackPanel Style="{StaticResource Field}"><TextBlock Text="Contact mobile" Style="{StaticResource Label}"/><TextBox Text="{Binding DeveloperMobile}"/></StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Save Settings" Command="{Binding SaveCenterCommand}" HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,20"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 1 -->
        <TabItem Header="Users &amp; Roles" Visibility="{Binding CanAdmin, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding RolesHelp}" Style="{StaticResource SubTitle}" Margin="0,8,0,0"/>
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding RoleText}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Add / edit user" Style="{StaticResource Section}"/>
                        <TextBlock Text="Username" Style="{StaticResource Label}"/><TextBox Text="{Binding UName}"/>
                        <TextBlock Text="Full name" Style="{StaticResource Label}"/><TextBox Text="{Binding UFull}"/>
                        <TextBlock Text="Role" Style="{StaticResource Label}"/>
                        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:Lists.Roles}" SelectedItem="{Binding URole}"/>
                        <TextBlock Text="Password (empty = keep current)" Style="{StaticResource Label}"/><TextBox Text="{Binding UPassword}"/>
                        <CheckBox Content="Active" IsChecked="{Binding UActive}"/>
                        <WrapPanel>
                            <Button Content="Save User" Command="{Binding SaveUserCommand}" Style="{StaticResource Small}"/>
                            <Button Content="New" Command="{Binding NewUserCommand}" Style="{StaticResource Small}" Background="#6B91B5"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- 2 -->
        <TabItem Header="Vaccine Database &amp; Protocols" Visibility="{Binding CanVaccines, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="New Vaccine" Command="{Binding NewVaccineCommand}" Margin="0,8,0,0" Style="{StaticResource NavyButton}"/>
                    <ListBox ItemsSource="{Binding VaccineList}" SelectedItem="{Binding Vaccine}" DisplayMemberPath="Name" BorderBrush="#D8E5EC" Padding="4"/>
                </DockPanel>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Vaccine record" Style="{StaticResource Section}"/>
                                <WrapPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Code" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.Code}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Vaccine name" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.Name}"/></StackPanel>
                                    <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Full name" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.FullName}"/></StackPanel>
                                    <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Disease prevented" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.DiseasePrevented}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Recommended age" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.RecommendedAge}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Minimum age" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.MinimumAge}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Dose volume" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.DoseVolume}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Route" Style="{StaticResource Label}"/>
                                        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:Lists.Routes}" SelectedItem="{Binding Vaccine.Route}"/></StackPanel>
                                    <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Injection site" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.InjectionSite}"/></StackPanel>
                                    <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Booster requirements" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.BoosterRequirements}"/></StackPanel>
                                    <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Storage temperature" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.StorageTemperature}"/></StackPanel>
                                    <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Special instructions" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.SpecialInstructions}"/></StackPanel>
                                    <StackPanel Style="{StaticResource WideField}"><TextBlock Text="Reference / source" Style="{StaticResource Label}"/><TextBox Text="{Binding Vaccine.Reference}" TextWrapping="Wrap"/></StackPanel>
                                </WrapPanel>
                                <CheckBox Content="Active (shown in lists)" IsChecked="{Binding Vaccine.IsActive}"/>
                                <Button Content="Save Vaccine" Command="{Binding SaveVaccineCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="New Protocol" Command="{Binding NewProtocolCommand}" Style="{StaticResource Small}"/>
                            <TextBlock Text="Protocols of this vaccine" Style="{StaticResource Section}" Margin="0"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding VaccineProtocols}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Button Content="Edit" Style="{StaticResource Small}" Margin="0,0,0,6"
                                                        Command="{Binding DataContext.EditProtocolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Content="Approve / Withdraw" Style="{StaticResource Small}" Background="#15803D"
                                                        Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                                                <TextBlock Text="{Binding TargetGroup}" Foreground="#64748B"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Approved by center: " Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding ApprovedByCenter}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="  " /><TextBlock Text="{Binding ApprovedBy}" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Reference}" TextWrapping="Wrap" FontSize="11" Foreground="#78716C"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- 3 -->
        <TabItem Header="Backup &amp; Restore" Visibility="{Binding CanAdmin, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" VerticalAlignment="Top" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Backup &amp; restore" Style="{StaticResource Section}"/>
                    <TextBlock Text="{Binding BackupInfo}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Create Backup Now" Command="{Binding BackupCommand}" Style="{StaticResource Small}"/>
                        <Button Content="Restore From Backup" Command="{Binding RestoreCommand}" Style="{StaticResource Small}" Background="#B91C1C"/>
                        <Button Content="Open Backup Folder" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource Small}" Background="#64748B"/>
                    </WrapPanel>
                    <TextBlock Text="All data is stored on this computer and works without internet. Copy a backup to a USB drive regularly. Clinical records are never deleted permanently by normal use."
                               Style="{StaticResource SubTitle}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </TabItem>

        <!-- 4 -->
        <TabItem Header="My Password">
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" VerticalAlignment="Top" Width="380" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Change my password" Style="{StaticResource Section}"/>
                    <TextBlock Text="Current password" Style="{StaticResource Label}"/>
                    <PasswordBox x:Name="OldPwd" PasswordChanged="OnPassword"/>
                    <TextBlock Text="New password (at least 6 characters)" Style="{StaticResource Label}"/>
                    <PasswordBox x:Name="NewPwd" PasswordChanged="OnPassword"/>
                    <Button Content="Change Password" Command="{Binding ChangePasswordCommand}"/>
                </StackPanel>
            </Border>
        </TabItem>

        <!-- 5 -->
        <TabItem Header="About Software">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Image Source="pack://application:,,,/BurhanNexus.Vaccinator;component/Assets/icon-256.png" Width="90" Height="90"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AboutTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Navy}"/>
                                <TextBlock Text="{Binding AboutDeveloper}" FontSize="14" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AboutVersion}" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding AboutText}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"/>
                        <Image Source="pack://application:,,,/BurhanNexus.Vaccinator;component/Assets/burhan-nexus-logo.png" Height="60" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding AboutContact}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AboutCopyright}" Foreground="#64748B" Margin="0,4,0,12"/>
                        <Border Style="{StaticResource Note}"><TextBlock Text="{Binding AboutSafety}" TextWrapping="Wrap" Foreground="#92400E"/></Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
