<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.ScheduleCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14,12">
            <WrapPanel>
                <StackPanel Width="200" Margin="0,0,12,0">
                    <TextBlock Text="Vaccine" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Vaccines}" SelectedItem="{Binding Vaccine}" DisplayMemberPath="Name" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Width="380" Margin="0,0,12,0">
                    <TextBlock Text="Protocol (select the verified protocol)" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" DisplayMemberPath="Name" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Width="170" Margin="0,0,12,0">
                    <TextBlock Text="{Binding AnchorLabel}" Style="{StaticResource Label}"/>
                    <DatePicker SelectedDate="{Binding Anchor}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="Print Schedule" Command="{Binding PrintCommand}" VerticalAlignment="Bottom" Style="{StaticResource NavyButton}"/>
            </WrapPanel>
        </Border>
        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="2,0,0,6"/>
            <Border Style="{StaticResource Note}">
                <StackPanel>
                    <TextBlock Text="{Binding Protocol.ApprovalText}" FontWeight="SemiBold" Foreground="#92400E"/>
                    <TextBlock Text="{Binding Protocol.CatchUpRule}" TextWrapping="Wrap" Foreground="#92400E"/>
                    <TextBlock Text="{Binding Protocol.Reference, StringFormat=Reference: {0}}" TextWrapping="Wrap" Foreground="#78716C" FontSize="11.5"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Doses}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dose" Binding="{Binding Label}" Width="2*"/>
                <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="2*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110"/>
                <DataGridTextColumn Header="Day" Binding="{Binding Weekday}" Width="100"/>
                <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="*"/>
                <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="140"/>
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
