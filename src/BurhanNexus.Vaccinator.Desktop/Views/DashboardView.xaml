<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{Binding Updated}" Foreground="#94A3B8" FontSize="11.5" Margin="6,0,0,4"/>
            <!-- Statistic cards -->
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatCard}" Width="214">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Navy}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Charts -->
            <ItemsControl ItemsSource="{Binding Charts}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatCard}" Width="440" Height="230">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Bars}" VerticalAlignment="Bottom">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="1,0" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Value}" FontSize="10" HorizontalAlignment="Center" Foreground="#334155"/>
                                                    <Border Height="{Binding Height}" Background="{Binding Color}" CornerRadius="4,4,0,0" Margin="3,2,3,0" MaxWidth="34" ToolTip="{Binding Value}"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Height="26"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sections -->
            <Border Style="{StaticResource Card}" Margin="6,8,6,14">
                <TabControl Background="Transparent" BorderThickness="0" Height="380">
                    <TabItem Header="Today's Appointments">
                        <DataGrid ItemsSource="{Binding D.TodaysAppointments}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientNo}" Width="100"/>
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                                <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="115"/>
                                <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="*"/>
                                <DataGridTextColumn Header="Dose" Binding="{Binding DoseLabel}" Width="*"/>
                                <DataGridTextColumn Header="Previous" Binding="{Binding PreviousText}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Upcoming (7 days)">
                        <DataGrid ItemsSource="{Binding D.UpcomingAppointments}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="95"/>
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                                <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="115"/>
                                <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="*"/>
                                <DataGridTextColumn Header="Dose" Binding="{Binding DoseLabel}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Overdue Patients">
                        <DataGrid ItemsSource="{Binding D.OverduePatients}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="95"/>
                                <DataGridTextColumn Header="Days late" Binding="{Binding DaysOverdue}" Width="75"/>
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                                <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="115"/>
                                <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="*"/>
                                <DataGridTextColumn Header="Dose" Binding="{Binding DoseLabel}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Recent Registrations">
                        <DataGrid ItemsSource="{Binding D.RecentPatients}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientNo}" Width="100"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Father / Husband" Binding="{Binding GuardianName}" Width="2*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Registered" Binding="{Binding RegisteredText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Recent Vaccinations">
                        <DataGrid ItemsSource="{Binding D.RecentVaccinations}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="95"/>
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                                <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="*"/>
                                <DataGridTextColumn Header="Dose" Binding="{Binding Dose}" Width="*"/>
                                <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Low Vaccine Stock">
                        <DataGrid ItemsSource="{Binding D.LowStock}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="*"/>
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*"/>
                                <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="80"/>
                                <DataGridTextColumn Header="Alert level" Binding="{Binding LowStockLevel}" Width="80"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" ElementStyle="{StaticResource StatusText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Expiring Vaccines">
                        <DataGrid ItemsSource="{Binding D.Expiring}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="*"/>
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*"/>
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryText}" Width="100"/>
                                <DataGridTextColumn Header="Days left" Binding="{Binding DaysToExpiry}" Width="80"/>
                                <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="80"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource StatusText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Recent Insulin">
                        <DataGrid ItemsSource="{Binding D.RecentInsulin}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="95"/>
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                                <DataGridTextColumn Header="Insulin" Binding="{Binding Product}" Width="2*"/>
                                <DataGridTextColumn Header="Vials" Binding="{Binding Vials}" Width="60"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding TotalText}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
