<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.NewbornView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BurhanNexus.Vaccinator.Desktop.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="330"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="330"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Baby details" Style="{StaticResource Section}"/>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Baby Name (optional)" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding BabyName}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Gender *" Style="{StaticResource Label}"/>
                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:Lists.Genders}" SelectedItem="{Binding Gender}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Date of Birth *" Style="{StaticResource Label}"/>
                            <DatePicker SelectedDate="{Binding DateOfBirth}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Time of Birth (optional, e.g. 08:30 PM)" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding TimeOfBirth}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Father Name *" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding FatherName}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Mother Name" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding MotherName}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Mother Mobile Number" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding MotherMobile}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Hospital / Birth Center" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding BirthPlace}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Birth Weight in kg (optional)" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding BirthWeight}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Registration Date" Style="{StaticResource Label}"/>
                            <DatePicker SelectedDate="{Binding RegistrationDate}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Advised By (Doctor)" Style="{StaticResource Label}"/>
                            <ComboBox Style="{StaticResource FieldCombo}" IsEditable="True" ItemsSource="{Binding DoctorNames}" Text="{Binding AdvisedBy, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Complete Address" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Address}"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding AgeText}" Foreground="{StaticResource Primary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Button Content="Register Newborn &amp; Create EPI Schedule" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Recommended EPI schedule (Pakistan)" Style="{StaticResource Section}"/>
                    <TextBlock Text="Birth · 6 weeks · 10 weeks · 14 weeks · 9 months · 15 months. Calculated from the date of birth. Doses not given on time are shown as OVERDUE."
                               Style="{StaticResource SubTitle}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Timeline}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource CompactGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Due date" Binding="{Binding DateText}" Width="95"/>
                        <DataGridTextColumn Header="Age" Binding="{Binding Schedule}" Width="120"/>
                        <DataGridTextColumn Header="Vaccine / dose" Binding="{Binding Label}" Width="*"/>
                        <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
