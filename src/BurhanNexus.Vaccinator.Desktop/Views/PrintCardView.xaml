<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.PrintCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding Text}" Margin="0" ToolTip="Name, patient ID, CNIC or mobile">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="Vaccination Card" Command="{Binding CardCommand}" Style="{StaticResource Small}"/>
            <Button Content="Newborn Immunization Card" Command="{Binding NewbornCommand}" Style="{StaticResource Small}" Background="#0EA5E9"/>
            <Button Content="Anti-Rabies Card" Command="{Binding RabiesCommand}" Style="{StaticResource Small}" Background="#B91C1C"/>
            <Button Content="Upcoming Dose Schedule" Command="{Binding ScheduleCommand}" Style="{StaticResource Small}" Background="#0369A1"/>
            <Button Content="Vaccination History" Command="{Binding HistoryCommand}" Style="{StaticResource Small}" Background="#475569"/>
            <Button Content="Registration Form" Command="{Binding FormCommand}" Style="{StaticResource Small}" Background="#123B50"/>
        </WrapPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientNo}" Width="110"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Father / Husband" Binding="{Binding GuardianName}" Width="2*"/>
                <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="130"/>
                <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="120"/>
                <DataGridTextColumn Header="CNIC" Binding="{Binding Cnic}" Width="140"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
