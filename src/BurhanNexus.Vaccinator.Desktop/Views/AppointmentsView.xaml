<UserControl x:Class="BurhanNexus.Vaccinator.Desktop.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Today" Command="{Binding FilterCommand}" CommandParameter="Today" Style="{StaticResource Small}"/>
                    <Button Content="Tomorrow" Command="{Binding FilterCommand}" CommandParameter="Tomorrow" Style="{StaticResource Small}"/>
                    <Button Content="Next 7 Days" Command="{Binding FilterCommand}" CommandParameter="Next7Days" Style="{StaticResource Small}"/>
                    <Button Content="Next 30 Days" Command="{Binding FilterCommand}" CommandParameter="Next30Days" Style="{StaticResource Small}"/>
                    <Button Content="All Upcoming" Command="{Binding FilterCommand}" CommandParameter="AllUpcoming" Style="{StaticResource Small}"/>
                    <Button Content="Overdue" Command="{Binding FilterCommand}" CommandParameter="Overdue" Style="{StaticResource Small}" Background="#B91C1C"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="12,0,6,0" ToolTip="Patient name, ID, mobile or vaccine">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource Small}" Background="#6B91B5"/>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Mark Completed (record dose)" Command="{Binding CompleteCommand}" Style="{StaticResource Small}" Background="#15803D"/>
                    <Button Content="Reschedule" Command="{Binding RescheduleCommand}" Style="{StaticResource Small}" Background="#6B91B5"/>
                    <Button Content="Patient Not Arrived" Command="{Binding NotArrivedCommand}" Style="{StaticResource Small}" Background="#C2410C"/>
                    <Button Content="Open Patient" Command="{Binding OpenCommand}" Style="{StaticResource Small}" Background="#123B50"/>
                    <Button Content="Print List" Command="{Binding PrintCommand}" Style="{StaticResource Small}" Background="#334155"/>
                    <Button Content="Export PDF / Excel" Command="{Binding ExcelCommand}" Style="{StaticResource Small}" Background="#0F766E" ToolTip="Excel file. Use Print List for PDF."/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding FilterTitle}" Style="{StaticResource Section}" Margin="2,0,0,6"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Due date" Binding="{Binding DueText}" Width="95"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource StatusText}"/>
                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientNo}" Width="100"/>
                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="115"/>
                <DataGridTextColumn Header="Vaccine" Binding="{Binding Vaccine}" Width="110"/>
                <DataGridTextColumn Header="Dose" Binding="{Binding DoseLabel}" Width="*"/>
                <DataGridTextColumn Header="Previous dose" Binding="{Binding PreviousText}" Width="105"/>
                <DataGridTextColumn Header="Days late" Binding="{Binding DaysOverdue}" Width="75"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Count}" Foreground="#64748B" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding SmsNote}" Foreground="#94A3B8" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
